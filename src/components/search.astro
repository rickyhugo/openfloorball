<div class="relative w-full" data-search>
  <label class="sr-only" for="global-search">
    Sök
  </label>
  <input
    id="global-search"
    type="search"
    placeholder="Sök lag, serie, match, spelare"
    autocomplete="off"
    spellcheck="false"
    role="combobox"
    aria-expanded="false"
    aria-controls="global-search-results"
    aria-autocomplete="list"
    class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30"
  />
  <div
    id="global-search-results"
    data-results
    role="listbox"
    class="absolute inset-x-0 top-full z-50 mt-1 hidden max-h-96 overflow-y-auto rounded-md border bg-popover py-1 text-popover-foreground shadow-sm"
  ></div>
</div>

<script>
  type Hit = {
    kind: string
    title: string
    subtitle: string | null
    url: string
  }
  type Group = { kind: string; label: string; items: Hit[] }

  const root = document.querySelector<HTMLElement>("[data-search]")
  if (root && root.dataset.ready !== "1") {
    root.dataset.ready = "1"
    const input = root.querySelector<HTMLInputElement>("input")!
    const list = root.querySelector<HTMLElement>("[data-results]")!
    const labels: Record<string, string> = {
      competition: "Serier",
      team: "Lag",
      game: "Matcher",
      player: "Spelare",
    }
    let options: HTMLAnchorElement[] = []
    let active = -1
    let controller: AbortController | null = null
    let timer: number | undefined

    const close = () => {
      list.classList.add("hidden")
      input.setAttribute("aria-expanded", "false")
      input.removeAttribute("aria-activedescendant")
      active = -1
    }

    const setActive = (index: number) => {
      if (!options.length) return
      active = (index + options.length) % options.length
      options.forEach((option, optionIndex) => {
        option.classList.toggle("bg-muted", optionIndex === active)
      })
      input.setAttribute("aria-activedescendant", options[active].id)
      options[active].scrollIntoView({ block: "nearest" })
    }

    const render = (groups: Group[]) => {
      list.replaceChildren()
      options = []
      if (!groups.length) {
        const empty = document.createElement("p")
        empty.className = "px-3 py-2 text-sm text-muted-foreground"
        empty.textContent = "Inga träffar."
        list.append(empty)
      }
      for (const group of groups) {
        const heading = document.createElement("p")
        heading.className =
          "px-3 pt-2 pb-1 text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase"
        heading.textContent = group.label
        list.append(heading)
        for (const hit of group.items) {
          const option = document.createElement("a")
          option.href = hit.url
          option.id = `search-option-${options.length}`
          option.setAttribute("role", "option")
          option.className =
            "flex flex-col gap-0.5 px-3 py-2 text-sm hover:bg-muted focus-visible:bg-muted focus-visible:outline-none"
          const title = document.createElement("span")
          title.textContent = hit.title
          const subtitle = document.createElement("span")
          subtitle.className = "text-xs text-muted-foreground"
          subtitle.textContent = hit.subtitle ?? ""
          option.append(title, subtitle)
          list.append(option)
          options.push(option)
        }
      }
      list.classList.remove("hidden")
      input.setAttribute("aria-expanded", "true")
      active = -1
    }

    const run = async () => {
      const query = input.value.trim()
      if (query.length < 2) {
        close()
        return
      }
      controller?.abort()
      controller = new AbortController()
      try {
        const response = await fetch(
          `/api/search?q=${encodeURIComponent(query)}`,
          {
            signal: controller.signal,
          }
        )
        if (!response.ok) return
        const data = (await response.json()) as { hits: Hit[] }
        const groups = new Map<string, Hit[]>()
        for (const hit of data.hits) {
          const bucket = groups.get(hit.kind) ?? []
          bucket.push(hit)
          groups.set(hit.kind, bucket)
        }
        render(
          [...groups.entries()].map(([kind, items]) => ({
            kind,
            label: labels[kind] ?? kind,
            items,
          }))
        )
      } catch (error) {
        if ((error as Error).name !== "AbortError") console.error(error)
      }
    }

    input.addEventListener("input", () => {
      window.clearTimeout(timer)
      timer = window.setTimeout(run, 120)
    })
    input.addEventListener("focus", () => {
      if (input.value.trim().length >= 2 && options.length) {
        list.classList.remove("hidden")
        input.setAttribute("aria-expanded", "true")
      }
    })
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault()
        setActive(active + 1)
      } else if (event.key === "ArrowUp") {
        event.preventDefault()
        setActive(active - 1)
      } else if (event.key === "Enter") {
        if (active >= 0) {
          event.preventDefault()
          options[active].click()
        }
      } else if (event.key === "Escape") {
        close()
      }
    })
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) close()
    })
  }
</script>

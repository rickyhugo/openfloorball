---
import "@/styles/global.css"

type Props = {
  title?: string
  description?: string
}

const {
  title = "SSL Herrar 2024/25, tabell",
  description = "Tabell för SSL Herrar 2024/25 med spelade matcher, målskillnad och poäng.",
} = Astro.props
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <slot />
  </body>
</html>

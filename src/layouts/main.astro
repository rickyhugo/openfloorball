---
import "@/styles/global.css"
import Search from "@/components/search.astro"

type Props = {
  title?: string
  description?: string
}

const {
  title = "OpenFloorball, svensk innebandy",
  description = "Tabeller, resultat och statistik för svensk innebandy.",
} = Astro.props
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="min-h-svh">
    <header class="border-b border-border/70">
      <div class="mx-auto flex w-full max-w-5xl items-center gap-4 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="font-heading text-lg font-semibold tracking-tight whitespace-nowrap"
        >
          OpenFloorball
        </a>
        <div class="ml-auto w-full max-w-sm">
          <Search />
        </div>
      </div>
    </header>
    <slot />
  </body>
</html>

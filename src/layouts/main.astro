---
import "@/styles/global.css"
import { AppShell, type NavGroup } from "@/components/app-shell"
import { listCompetitions, listCountries } from "@/lib/db/queries"

type Props = {
  title?: string
  description?: string
}

const {
  title = "OpenFloorball",
  description = "Tabeller, resultat och statistik.",
} = Astro.props

const allCompetitions = await listCompetitions()
const latestSeason = allCompetitions.reduce(
  (latest, row) => (row.seasonLabel > latest ? row.seasonLabel : latest),
  ""
)
const competitions = allCompetitions.filter(
  (row) => row.seasonLabel === latestSeason
)
const countries = await listCountries(latestSeason)
const sslMen = competitions.find(
  (row) => row.name.includes("SSL") && row.name.includes("Herrar")
)
const sslWomen = competitions.find(
  (row) => row.name.includes("SSL") && row.name.includes("Damer")
)
const allsMen = competitions.find((row) =>
  row.name.includes("Allsvenskan Herrar")
)
const allsWomen = competitions.find((row) =>
  row.name.includes("Allsvenskan Damer")
)

const countryGroups: NavGroup[] = countries.map((country) => ({
  label: country.name,
  items: [
    { label: "Herrar", href: `/serier?land=${country.id}&kon=men` },
    { label: "Damer", href: `/serier?land=${country.id}&kon=women` },
    { label: "Alla serier", href: `/serier?land=${country.id}` },
  ],
}))

const nav: NavGroup[] = [
  {
    label: "Översikt",
    items: [
      { label: "Start", href: "/" },
      { label: "Live", href: "/live" },
      { label: "Alla serier", href: "/serier" },
    ],
  },
  ...countryGroups,
  {
    label: "Toppserier",
    items: [
      sslMen
        ? { label: "SSL Herrar", href: `/serie/${sslMen.externalId}` }
        : null,
      sslWomen
        ? { label: "SSL Damer", href: `/serie/${sslWomen.externalId}` }
        : null,
      allsMen
        ? { label: "Allsvenskan Herrar", href: `/serie/${allsMen.externalId}` }
        : null,
      allsWomen
        ? {
            label: "Allsvenskan Damer",
            href: `/serie/${allsWomen.externalId}`,
          }
        : null,
    ].filter((item): item is { label: string; href: string } => item !== null),
  },
]
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="min-h-svh">
    <AppShell client:load nav={nav}>
      <slot />
    </AppShell>
  </body>
</html>

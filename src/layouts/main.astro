---
import "@/styles/global.css"
import { AppShell, type NavGroup } from "@/components/app-shell"
import { listCompetitions, listCountries } from "@/lib/db/queries"

type Props = {
  title?: string
  description?: string
}

const {
  title = "OpenFloorball",
  description = "Tabeller, resultat och statistik.",
} = Astro.props

const allCompetitions = await listCompetitions()
const latestSeason = allCompetitions.reduce(
  (latest, row) => (row.seasonLabel > latest ? row.seasonLabel : latest),
  ""
)
const competitions = allCompetitions.filter(
  (row) => row.seasonLabel === latestSeason
)
const countries = await listCountries(latestSeason)

const topPattern: Record<string, RegExp> = {
  SE: /SSL/,
  FI: /F-Liiga/,
  CH: /L-UPL/,
}

function leagueLabel(name: string, gender: string) {
  const genderLabel = gender === "men" ? "Herrar" : "Damer"
  if (/SSL/i.test(name)) return `SSL ${genderLabel}`
  if (/F-Liiga/i.test(name)) return `F-Liiga ${genderLabel}`
  if (/L-UPL/i.test(name)) return `L-UPL ${genderLabel}`
  return name
}

const countryGroups: NavGroup[] = countries.flatMap((country) => {
  const inCountry = competitions.filter((row) => row.countryId === country.id)
  const pattern = topPattern[country.id]
  const pick = (gender: "men" | "women") => {
    const rows = inCountry.filter((row) => row.gender === gender)
    return pattern
      ? (rows.find((row) => pattern.test(row.name)) ?? rows[0])
      : rows[0]
  }
  const men = pick("men")
  const women = pick("women")
  const items = [
    men
      ? {
          label: leagueLabel(men.name, "men"),
          href: `/serie/${men.externalId}`,
        }
      : null,
    women
      ? {
          label: leagueLabel(women.name, "women"),
          href: `/serie/${women.externalId}`,
        }
      : null,
    { label: "Alla serier", href: `/serier?land=${country.id}` },
  ].filter((item): item is { label: string; href: string } => item !== null)
  return items.length ? [{ label: country.name, items }] : []
})

const nav: NavGroup[] = [
  {
    label: "Översikt",
    items: [
      { label: "Start", href: "/" },
      { label: "Live", href: "/live" },
      { label: "Alla serier", href: "/serier" },
      { label: "Om sidan", href: "/om" },
    ],
  },
  ...countryGroups,
]
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem("theme")
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches
          document.documentElement.classList.toggle("dark", dark)
          document.documentElement.style.colorScheme = dark ? "dark" : "light"
        } catch {}
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class="min-h-svh">
    <AppShell
      client:load
      nav={nav}
      location={Astro.url.pathname + Astro.url.search}
    >
      <slot />
    </AppShell>
  </body>
</html>

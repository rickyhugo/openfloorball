---
import Layout from "@/layouts/main.astro"
import { StandingTable } from "@/components/standings-table"
import { getCompetition } from "@/lib/db/queries"
import { PageHeader } from "@/components/page-header"
import { LeaderboardCard } from "@/components/leaderboard-card"
import { Badge } from "@/components/ui/badge"
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"

export const prerender = false

const { id } = Astro.params
if (!id) return Astro.redirect("/")

const data = await getCompetition(id)
if (!data) return Astro.redirect("/")

const standingRows = data.standings.map((row) => ({
  position: row.position,
  teamId: row.teamId,
  teamName: row.teamName,
  teamHref: `/lag/${id}/${row.teamExternalId}`,
  played: row.played,
  regulationWins: row.regulationWins,
  overtimeWins: row.overtimeWins,
  overtimeLosses: row.overtimeLosses,
  regulationLosses: row.regulationLosses,
  goalsFor: row.goalsFor,
  goalsAgainst: row.goalsAgainst,
  points: row.points,
}))

const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  weekday: "short",
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Europe/Stockholm",
})

function formatDate(value: Date | null) {
  return value ? dateFormat.format(value) : "Tid ej satt"
}

function suffix(decidedBy: string | null) {
  if (decidedBy === "overtime") return " e.förl."
  if (decidedBy === "shootout") return " str."
  return ""
}

const finished = data.games.filter((game) => game.status === "finished")
const upcoming = data.games.filter((game) => game.status === "scheduled")

const rounds = new Map<string, typeof finished>()
for (const game of finished) {
  const key = game.round ?? "Matcher"
  rounds.set(key, [...(rounds.get(key) ?? []), game])
}
const orderedRounds = [...rounds.entries()].sort(
  (a, b) =>
    Math.min(...b[1].map((game) => game.startsAt?.getTime() ?? 0)) -
    Math.min(...a[1].map((game) => game.startsAt?.getTime() ?? 0))
)

const title = `${data.name} ${data.seasonLabel}`
const liveSource =
  data.source === "fliiga"
    ? "fi"
    : data.source === "swissunihockey"
      ? "ch"
      : "se"
const leaderboards = [
  {
    label: "Skytteliga",
    unit: "Mål",
    rows: [...data.leaders]
      .sort((a, b) => b.goals - a.goals || b.points - a.points)
      .slice(0, 10),
    value: (row: (typeof data.leaders)[number]) => row.goals,
  },
  {
    label: "Assistliga",
    unit: "Ass",
    rows: [...data.leaders]
      .sort((a, b) => b.assists - a.assists || b.points - a.points)
      .slice(0, 10),
    value: (row: (typeof data.leaders)[number]) => row.assists,
  },
  {
    label: "Poängliga",
    unit: "P",
    rows: [...data.leaders]
      .sort((a, b) => b.points - a.points || b.goals - a.goals)
      .slice(0, 10),
    value: (row: (typeof data.leaders)[number]) => row.points,
  },
  {
    label: "Utvisningsliga",
    unit: "Utv",
    empty: "Utvisningsminuter saknas i den fria datan för denna serie.",
    rows: [...data.leaders]
      .filter((row) => row.penaltyMinutes > 0)
      .sort(
        (a, b) =>
          b.penaltyMinutes - a.penaltyMinutes ||
          a.matches - b.matches ||
          a.playerName.localeCompare(b.playerName, "sv")
      )
      .slice(0, 10),
    value: (row: (typeof data.leaders)[number]) => row.penaltyMinutes,
  },
]
const sourceUrl =
  data.source === "fliiga"
    ? "fliiga.com"
    : data.source === "swissunihockey"
      ? "myapp.swissunihockey.ch"
      : "stats.innebandy.se"
---

<Layout
  title={`${title}, tabell och resultat`}
  description={`Tabell, resultat och skytteliga för ${data.name} ${data.seasonLabel}.`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <PageHeader
      eyebrow={[
        { href: "/serier", label: "Alla serier" },
        { label: data.categoryName ?? data.name },
      ]}
      title={data.name}
      description={`${data.name} · ${data.seasonLabel} · ${standingRows.length} lag · Källa: ${sourceUrl}`}
    />

    <StandingTable
      competition={data.name}
      season={data.seasonLabel}
      source={sourceUrl}
      updatedLabel={`${standingRows.length} lag`}
      rows={standingRows}
      client:visible
    />

    {orderedRounds.length > 0 ? (
      <section class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">Resultat</h2>
        <div class="mt-4 divide-y border-y">
          {orderedRounds.map(([round, games], index) => (
            <details open={index < 2} class="group py-3">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium">
                <span>{round}</span>
                <span class="text-xs font-normal text-muted-foreground">
                  {games.length} matcher
                </span>
              </summary>
              <ul class="mt-3 space-y-2">
                {games.map((game) => (
                  <li id={`match-${game.externalId}`} class="scroll-mt-24">
                    <a
                      href={`/live/${liveSource}/${game.externalId}`}
                      class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 px-1 text-sm hover:bg-muted/50"
                    >
                      <span class="truncate text-right">{game.homeName}</span>
                      <span class="whitespace-nowrap">
                        <Badge
                          variant="secondary"
                          className="font-semibold tabular-nums"
                        >
                          {game.homeScore ?? "-"}-{game.awayScore ?? "-"}
                        </Badge>
                        <span class="text-xs font-normal text-muted-foreground">
                          {suffix(game.decidedBy)}
                        </span>
                      </span>
                      <span class="truncate">{game.awayName}</span>
                      <span class="col-span-3 text-center text-xs text-muted-foreground">
                        {formatDate(game.startsAt)}
                        {game.venue ? `, ${game.venue}` : ""}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </section>
    ) : null}

    {upcoming.length > 0 ? (
      <section class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">Kommande matcher</h2>
        <ul class="mt-4 divide-y border-y">
          {upcoming.slice(0, 12).map((game) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 py-2.5 text-sm">
              <span class="truncate text-right">{game.homeName}</span>
              <span class="whitespace-nowrap text-xs text-muted-foreground">
                {formatDate(game.startsAt)}
              </span>
              <span class="truncate">{game.awayName}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    {data.leaders.length > 0 ? (
      <section class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">Spelarstatistik</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {leaderboards.map((board) => (
            <LeaderboardCard
              title={board.label}
              unit={board.unit}
              empty={"empty" in board ? board.empty : undefined}
              rows={board.rows.map((row) => ({
                href: `/spelare/${row.playerExternalId}`,
                name: row.playerName,
                subtitle: row.clubName,
                value: board.value(row),
              }))}
            />
          ))}
        </div>
      </section>
    ) : null}

    {data.goalies.length > 0 ? (
      <section class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">Målvakter</h2>
        <div class="mt-4 border-y">
          <Table className="text-sm">
            <TableHeader>
              <TableRow className="hover:bg-transparent">
                <TableHead className="tracking-wider uppercase">
                  Spelare
                </TableHead>
                <TableHead className="hidden tracking-wider uppercase sm:table-cell">
                  Lag
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  M
                </TableHead>
                <TableHead className="hidden text-right tracking-wider uppercase sm:table-cell">
                  Skott
                </TableHead>
                <TableHead className="hidden text-right tracking-wider uppercase sm:table-cell">
                  IM
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  Räddning %
                </TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {data.goalies.map((row) => (
                <TableRow>
                  <TableCell className="py-2.5">
                    <a
                      href={`/spelare/${row.playerExternalId}`}
                      class="hover:underline"
                    >
                      {row.playerName}
                    </a>
                    <span class="block text-xs text-muted-foreground sm:hidden">
                      {row.clubName}
                    </span>
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-muted-foreground sm:table-cell">
                    {row.clubName}
                  </TableCell>
                  <TableCell className="py-2.5 text-right tabular-nums">
                    {row.matches}
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-right tabular-nums sm:table-cell">
                    {row.shotsAgainst}
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-right tabular-nums sm:table-cell">
                    {row.goalsAgainst}
                  </TableCell>
                  <TableCell className="py-2.5 text-right font-semibold tabular-nums">
                    {row.savePercentage.toFixed(2)}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </section>
    ) : null}
  </div>
</Layout>

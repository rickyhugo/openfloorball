---
import Layout from "@/layouts/main.astro"
import { LiveList } from "@/components/live-list"
import { getTodayLiveMatches } from "@/lib/ibis-live"

export const prerender = false

const data = await getTodayLiveMatches().catch((error) => {
  console.error("live page failed", error)
  return null
})
const dateLabel = data
  ? new Intl.DateTimeFormat("sv-SE", {
      day: "numeric",
      month: "short",
    }).format(new Date(`${data.date}T12:00:00`))
  : null
---

<Layout title="Live" description="Live-matcher med resultat och händelser.">
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:py-12">
    <header class="border-b pb-6">
      <h1 class="font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
        Live
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Dagens matcher{dateLabel ? ` · ${dateLabel}` : ""}
      </p>
    </header>
    <LiveList initial={data} client:load />
  </div>
</Layout>

---
import Layout from "@/layouts/main.astro"
import { LiveMatch } from "@/components/live-match"
import { getLiveMatch, isLiveSource } from "@/lib/live"
import { LIVE_SOURCE_COUNTRY } from "@/lib/live-types"
import { PageHeader } from "@/components/page-header"

export const prerender = false

const source = Astro.params.source ?? ""
const id = Astro.params.id ?? ""
if (!isLiveSource(source) || !id) return Astro.redirect("/live")

const match = await getLiveMatch(source, id).catch((error) => {
  console.error("live match page failed", source, id, error)
  return null
})
if (!match) return Astro.redirect("/live")

const title = `${match.home.name} - ${match.away.name}`
const external = match.competitionHref?.startsWith("http")
---

<Layout
  title={`${title}, live`}
  description={`Live-resultat och händelser: ${title}.`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:py-12">
    <PageHeader
      eyebrow={[
        { href: "/live", label: "Live" },
        { label: LIVE_SOURCE_COUNTRY[source] },
        match.competitionHref
          ? {
              href: match.competitionHref,
              label: match.competition,
              external: true,
            }
          : { label: match.competition },
      ]}
      title={`${match.home.name} – ${match.away.name}`}
      description={[match.competition, match.round, match.venue]
        .filter(Boolean)
        .join(" · ")}
    />
    <LiveMatch initial={match} matchId={id} source={source} client:load />
  </div>
</Layout>

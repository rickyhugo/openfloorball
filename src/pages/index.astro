---
import Layout from "@/layouts/main.astro"
import { getLanding } from "@/lib/landing"
import { listCountries } from "@/lib/db/queries"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"

export const prerender = false

const data = await getLanding()
if (!data) return Astro.redirect("/serier")

const countries = await listCountries(data.seasonLabel)
const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  day: "numeric",
  month: "short",
  timeZone: "Europe/Stockholm",
})

function formatDate(value: Date | string) {
  return dateFormat.format(value instanceof Date ? value : new Date(value))
}

const sslMen = data.featured.find((entry) => entry.key === "ssl-men")
const sslWomen = data.featured.find((entry) => entry.key === "ssl-women")
const featured = [sslMen, sslWomen].filter(
  (entry): entry is NonNullable<typeof entry> => Boolean(entry)
)
---

<Layout
  title={`Innebandy ${data.seasonLabel}, tabeller och resultat`}
  description="Tabeller, resultat och statistik."
>
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
    <header class="border-b pb-6">
      <h1 class="font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
        Innebandy
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Säsong {data.seasonLabel}
      </p>
    </header>

    <section class="mt-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-heading text-2xl font-semibold">Länder</h2>
        <a
          href="/serier"
          class="text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
        >
          Alla serier
        </a>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {countries.map((country) => (
          <a
            href={`/serier?land=${country.id}`}
            class="rounded-xl border p-4 transition-colors hover:bg-muted"
          >
            <p class="font-heading text-xl font-semibold">{country.name}</p>
            <p class="mt-1 text-sm text-muted-foreground">
              {country.competitions} serier
            </p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="font-heading text-2xl font-semibold">Toppserier</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        {featured.map((entry) => (
          <Card>
            <CardHeader>
              <div class="flex items-center justify-between gap-3">
                <CardTitle className="font-heading text-xl">
                  {entry.label}
                </CardTitle>
                <a
                  href={`/serie/${entry.competition.externalId}`}
                  class="text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
                >
                  Hela tabellen
                </a>
              </div>
            </CardHeader>
            <CardContent>
              <Table>
                <TableHeader>
                  <TableRow>
                    <TableHead className="w-8">#</TableHead>
                    <TableHead>Lag</TableHead>
                    <TableHead className="text-right">S</TableHead>
                    <TableHead className="text-right">P</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {entry.standings.map((row) => (
                    <TableRow>
                      <TableCell className="text-muted-foreground tabular-nums">
                        {row.position}
                      </TableCell>
                      <TableCell className="font-medium">
                        <a
                          href={`/lag/${entry.competition.externalId}/${row.teamExternalId}`}
                          class="hover:underline"
                        >
                          {row.teamName}
                        </a>
                      </TableCell>
                      <TableCell className="text-right tabular-nums">
                        {row.played}
                      </TableCell>
                      <TableCell className="text-right font-semibold tabular-nums">
                        {row.points}
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </CardContent>
          </Card>
        ))}
      </div>
    </section>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
      <section>
        <h2 class="font-heading text-2xl font-semibold">Senaste resultat</h2>
        <Card className="mt-4">
          <CardContent>
            <ul class="divide-y">
              {data.latestGames.map((game) => (
                <li class="py-2.5">
                  <a
                    href={`/serie/${game.competitionExternalId}#match-${game.externalId}`}
                    class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 text-sm"
                  >
                    <span class="truncate text-right">{game.home}</span>
                    <span class="font-semibold whitespace-nowrap tabular-nums">
                      {game.homeScore ?? "-"}-{game.awayScore ?? "-"}
                    </span>
                    <span class="truncate">{game.away}</span>
                    <span class="col-span-3 text-center text-xs text-muted-foreground">
                      {game.competition} · {formatDate(game.startsAt)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      </section>

      <section>
        <h2 class="font-heading text-2xl font-semibold">Skytteligan</h2>
        <Card className="mt-4">
          <CardContent>
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Spelare</TableHead>
                  <TableHead className="text-right">Mål</TableHead>
                  <TableHead className="text-right">P</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {data.leaders.map((leader) => (
                  <TableRow>
                    <TableCell>
                      <a
                        href={`/spelare/${leader.playerExternalId}`}
                        class="block hover:underline"
                      >
                        {leader.playerName}
                        <span class="block text-xs text-muted-foreground">
                          {leader.clubName}
                        </span>
                      </a>
                    </TableCell>
                    <TableCell className="text-right tabular-nums">
                      {leader.goals}
                    </TableCell>
                    <TableCell className="text-right font-semibold tabular-nums">
                      {leader.points}
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </CardContent>
        </Card>
      </section>
    </div>
  </div>
</Layout>

---
import Layout from "@/layouts/main.astro"
import { getLanding } from "@/lib/landing"
import { listCountries } from "@/lib/db/queries"

export const prerender = false

const data = await getLanding()
if (!data) return Astro.redirect("/serier")

const countries = await listCountries(data.seasonLabel)
const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  day: "numeric",
  month: "short",
  timeZone: "Europe/Stockholm",
})

function formatDate(value: Date | string) {
  return dateFormat.format(value instanceof Date ? value : new Date(value))
}

const boards = new Map(data.boards.map((board) => [board.countryId, board]))
const liveSource = (source: string) =>
  source === "fliiga" ? "fi" : source === "swissunihockey" ? "ch" : "se"
const genders = [
  { key: "men" as const, label: "Herrar" },
  { key: "women" as const, label: "Damer" },
]
const leaderboards = [
  {
    label: "Skytteliga",
    unit: "Mål",
    rows: data.leaders.goals,
    value: (leader: (typeof data.leaders.goals)[number]) => leader.goals,
  },
  {
    label: "Assistliga",
    unit: "Ass",
    rows: data.leaders.assists,
    value: (leader: (typeof data.leaders.assists)[number]) => leader.assists,
  },
  {
    label: "Poängliga",
    unit: "P",
    rows: data.leaders.points,
    value: (leader: (typeof data.leaders.points)[number]) => leader.points,
  },
  {
    label: "Utvisningsliga",
    unit: "Utv",
    rows: data.leaders.penalties.filter((leader) => leader.penaltyMinutes > 0),
    note: "Schweiz saknar utvisningsminuter i den fria datan.",
    value: (leader: (typeof data.leaders.penalties)[number]) =>
      leader.penaltyMinutes,
  },
]
---

<Layout
  title="Innebandy, tabeller och resultat"
  description="Tabeller, resultat och live från Sverige, Finland och Schweiz."
>
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:py-10">
    <header class="flex flex-col gap-4 border-b pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
          OpenFloorball
        </h1>
        <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
          Tabeller, resultat och live från Sverige, Finland och Schweiz. Välj
          land för att börja.
        </p>
      </div>
      <a
        href="/live"
        class="inline-flex h-9 shrink-0 items-center justify-center border px-4 text-sm font-medium transition-colors hover:bg-muted"
      >
        Live
      </a>
    </header>

    <section class="mt-8">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-heading text-2xl font-semibold">Länder</h2>
        <a
          href="/serier"
          class="text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
        >
          Alla serier
        </a>
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-3">
        {countries.map((country) => {
          const board = boards.get(country.id)
          return (
            <article class="flex min-w-0 flex-col overflow-hidden border p-5">
              <div class="flex min-w-0 items-start justify-between gap-3">
                <div>
                  <a
                    href={`/serier?land=${country.id}`}
                    class="hover:underline"
                  >
                    <h3 class="font-heading text-2xl font-semibold">
                      {country.name}
                    </h3>
                  </a>
                  <p class="mt-1 text-xs text-muted-foreground">
                    {country.competitions} serier
                  </p>
                </div>
              </div>

              <div class="mt-5 grid gap-5">
                {genders.map((gender) => {
                  const competition = board?.[gender.key]
                  if (!competition) return null
                  return (
                    <div>
                      <div class="flex min-w-0 items-baseline justify-between gap-2">
                        <span class="shrink-0 text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
                          {gender.label}
                        </span>
                        <a
                          href={`/serie/${competition.externalId}`}
                          class="min-w-0 truncate text-right text-xs text-muted-foreground hover:text-foreground hover:underline"
                          title={competition.name}
                        >
                          {competition.name}
                        </a>
                      </div>
                      <ol class="mt-2 divide-y border-y">
                        {competition.standings.map((row) => (
                          <li>
                            <a
                              href={`/lag/${competition.externalId}/${row.teamExternalId}`}
                              class="grid min-w-0 grid-cols-[1.25rem_minmax(0,1fr)_auto] items-baseline gap-2 py-1.5 text-sm hover:bg-muted/50"
                            >
                              <span class="text-xs text-muted-foreground tabular-nums">
                                {row.position}
                              </span>
                              <span class="truncate font-medium">
                                {row.teamName}
                              </span>
                              <span class="font-semibold tabular-nums">
                                {row.points}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  )
                })}
              </div>

              <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-5 text-xs">
                <a
                  href={`/serier?land=${country.id}&kon=men`}
                  class="text-muted-foreground hover:text-foreground hover:underline"
                >
                  Herrar
                </a>
                <a
                  href={`/serier?land=${country.id}&kon=women`}
                  class="text-muted-foreground hover:text-foreground hover:underline"
                >
                  Damer
                </a>
                <a
                  href={`/serier?land=${country.id}`}
                  class="text-muted-foreground hover:text-foreground hover:underline"
                >
                  Alla serier
                </a>
              </div>
            </article>
          )
        })}
      </div>
    </section>

    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-heading text-2xl font-semibold">Senaste resultat</h2>
        <a
          href="/serier"
          class="text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
        >
          Serier
        </a>
      </div>
      <div class="mt-4 border-y">
        <ul class="grid sm:grid-cols-2 sm:gap-x-8">
          {data.latestGames.map((game) => (
            <li class="border-b">
              <a
                href={`/live/${liveSource(game.source)}/${game.externalId}`}
                class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 px-1 py-3 text-sm hover:bg-muted/50"
              >
                <span class="truncate text-right">{game.home}</span>
                <span class="font-semibold whitespace-nowrap tabular-nums">
                  {game.homeScore ?? "-"}-{game.awayScore ?? "-"}
                </span>
                <span class="truncate">{game.away}</span>
                <span class="col-span-3 text-center text-xs text-muted-foreground">
                  {game.countryName} · {game.competition} ·{" "}
                  {formatDate(game.startsAt)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-heading text-2xl font-semibold">Spelarstatistik</h2>
        <span class="text-xs text-muted-foreground">
          Toppserier · alla länder
        </span>
      </div>
      <div class="mt-4 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {leaderboards.map((board) => (
          <div class="min-w-0">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-heading text-xl font-semibold">{board.label}</h3>
              <span class="text-xs text-muted-foreground">{board.unit}</span>
            </div>
            <div class="mt-2 border-y">
              <ul class="divide-y">
                {board.rows.map((leader) => (
                  <li>
                    <a
                      href={`/spelare/${leader.playerExternalId}`}
                      class="flex min-w-0 items-baseline justify-between gap-3 px-1 py-3 text-sm hover:bg-muted/50"
                    >
                      <span class="min-w-0">
                        <span class="block truncate font-medium">
                          {leader.playerName}
                        </span>
                        <span class="block truncate text-xs text-muted-foreground">
                          {leader.countryName} · {leader.competitionName}
                        </span>
                      </span>
                      <span class="shrink-0 font-semibold tabular-nums">
                        {board.value(leader)}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            {"note" in board && board.note ? (
              <p class="mt-2 text-xs text-muted-foreground">{board.note}</p>
            ) : null}
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>

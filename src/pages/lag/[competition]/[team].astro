---
import Layout from "@/layouts/main.astro"
import { getTeam } from "@/lib/db/queries"

export const prerender = false

const { competition, team } = Astro.params
if (!competition || !team) return Astro.redirect("/")

const data = await getTeam(competition, team)
if (!data) return Astro.redirect("/")

const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  weekday: "short",
  day: "numeric",
  month: "short",
  timeZone: "Europe/Stockholm",
})

function formatDate(value: Date | null) {
  return value ? dateFormat.format(value) : "Tid ej satt"
}

function suffix(decidedBy: string | null) {
  if (decidedBy === "overtime") return " e.förl."
  if (decidedBy === "shootout") return " str."
  return ""
}

const finished = data.games
  .filter((game) => game.status === "finished")
  .slice(-5)
  .reverse()
const upcoming = data.games
  .filter((game) => game.status === "scheduled")
  .slice(0, 5)
const skaters = data.roster.filter((entry) => entry.savePercentage === null)
const goalies = data.roster.filter((entry) => entry.savePercentage !== null)
const standing = data.standing
const goalDifference = standing ? standing.goalsFor - standing.goalsAgainst : 0
---

<Layout
  title={`${data.clubName} ${data.seasonLabel}, trupp och matcher`}
  description={`Trupp, statistik och matcher för ${data.clubName} i ${data.competitionName} ${data.seasonLabel}.`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <nav class="mb-6 text-xs tracking-wider text-muted-foreground uppercase">
      <a
        href="/"
        class="underline decoration-border underline-offset-4 hover:text-foreground"
      >
        Alla serier
      </a>
      <span class="mx-2">/</span>
      <a
        href={`/serie/${data.competitionExternalId}`}
        class="underline decoration-border underline-offset-4 hover:text-foreground"
      >
        {data.competitionName}
      </a>
    </nav>

    <header class="border-b pb-8">
      <p class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase">
        {data.categoryName ?? data.competitionName}
      </p>
      <h1 class="mt-2 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
        {data.clubName}
      </h1>
      <p class="mt-3 text-muted-foreground">
        {data.competitionName} · {data.seasonLabel}
      </p>
      {standing ? (
        <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Placering
            </dt>
            <dd class="font-semibold tabular-nums">{standing.position}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Poäng
            </dt>
            <dd class="font-semibold tabular-nums">{standing.points}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Matcher
            </dt>
            <dd class="font-semibold tabular-nums">{standing.played}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Målskillnad
            </dt>
            <dd class="font-semibold tabular-nums">
              {goalDifference > 0 ? "+" : ""}
              {goalDifference}
            </dd>
          </div>
        </dl>
      ) : null}
    </header>

    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold">Trupp</h2>
      {skaters.length > 0 ? (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left text-xs tracking-wider text-muted-foreground uppercase">
                <th class="py-2 pr-3 font-medium">Spelare</th>
                <th class="py-2 pl-3 text-right font-medium">
                  <abbr title="Matcher" class="no-underline">
                    M
                  </abbr>
                </th>
                <th class="py-2 pl-3 text-right font-medium">Mål</th>
                <th class="py-2 pl-3 text-right font-medium">Ass</th>
                <th class="py-2 pl-3 text-right font-medium">P</th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  Utv
                </th>
              </tr>
            </thead>
            <tbody>
              {skaters.map((entry) => (
                <tr class="border-b border-border/60">
                  <td class="py-2 pr-3">
                    <a
                      href={`/spelare/${entry.playerExternalId}`}
                      class="hover:underline"
                    >
                      {entry.playerName}
                    </a>
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {entry.matches ?? "-"}
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {entry.goals ?? "-"}
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {entry.assists ?? "-"}
                  </td>
                  <td class="py-2 pl-3 text-right font-semibold tabular-nums">
                    {entry.points ?? "-"}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {entry.penaltyMinutes ?? "-"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">
          Ingen trupp registrerad ännu.
        </p>
      )}
    </section>

    {goalies.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Målvakter</h2>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left text-xs tracking-wider text-muted-foreground uppercase">
                <th class="py-2 pr-3 font-medium">Spelare</th>
                <th class="py-2 pl-3 text-right font-medium">M</th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  Skott
                </th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  IM
                </th>
                <th class="py-2 pl-3 text-right font-medium">Räddning %</th>
              </tr>
            </thead>
            <tbody>
              {goalies.map((entry) => (
                <tr class="border-b border-border/60">
                  <td class="py-2 pr-3">
                    <a
                      href={`/spelare/${entry.playerExternalId}`}
                      class="hover:underline"
                    >
                      {entry.playerName}
                    </a>
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {entry.goalieMatches ?? "-"}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {entry.shotsAgainst ?? "-"}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {entry.goalsAgainst ?? "-"}
                  </td>
                  <td class="py-2 pl-3 text-right font-semibold tabular-nums">
                    {entry.savePercentage != null
                      ? entry.savePercentage.toFixed(2)
                      : "-"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : null}

    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold">Senaste matcherna</h2>
      {finished.length > 0 ? (
        <ul class="mt-4 divide-y border-y">
          {finished.map((game) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 py-2.5 text-sm">
              <span class="truncate text-right">{game.homeName}</span>
              <span class="font-semibold whitespace-nowrap tabular-nums">
                {game.homeScore ?? "-"}-{game.awayScore ?? "-"}
                <span class="text-xs font-normal text-muted-foreground">
                  {suffix(game.decidedBy)}
                </span>
              </span>
              <span class="truncate">{game.awayName}</span>
              <a
                href={`/serie/${data.competitionExternalId}#match-${game.externalId}`}
                class="col-span-3 text-center text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
              >
                {formatDate(game.startsAt)}
                {game.round ? ` · ${game.round}` : ""}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">
          Inga spelade matcher ännu.
        </p>
      )}
    </section>

    {upcoming.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Kommande matcher</h2>
        <ul class="mt-4 divide-y border-y">
          {upcoming.map((game) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 py-2.5 text-sm">
              <span class="truncate text-right">{game.homeName}</span>
              <span class="whitespace-nowrap text-xs text-muted-foreground">
                {formatDate(game.startsAt)}
              </span>
              <span class="truncate">{game.awayName}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </div>
</Layout>

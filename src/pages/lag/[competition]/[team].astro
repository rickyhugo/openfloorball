---
import Layout from "@/layouts/main.astro"
import { getTeam } from "@/lib/db/queries"
import { PageHeader } from "@/components/page-header"
import { Badge } from "@/components/ui/badge"
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"

export const prerender = false

const { competition, team } = Astro.params
if (!competition || !team) return Astro.redirect("/")

const data = await getTeam(competition, team)
if (!data) return Astro.redirect("/")

const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  weekday: "short",
  day: "numeric",
  month: "short",
  timeZone: "Europe/Stockholm",
})

function formatDate(value: Date | null) {
  return value ? dateFormat.format(value) : "Tid ej satt"
}

function suffix(decidedBy: string | null) {
  if (decidedBy === "overtime") return " e.förl."
  if (decidedBy === "shootout") return " str."
  return ""
}

const finished = data.games
  .filter((game) => game.status === "finished")
  .slice(-5)
  .reverse()
const upcoming = data.games
  .filter((game) => game.status === "scheduled")
  .slice(0, 5)
const skaters = data.roster.filter((entry) => entry.savePercentage === null)
const goalies = data.roster.filter((entry) => entry.savePercentage !== null)
const hasPositions = skaters.some((entry) => entry.position)
const standing = data.standing
const goalDifference = standing ? standing.goalsFor - standing.goalsAgainst : 0
const liveSource =
  data.source === "fliiga"
    ? "fi"
    : data.source === "swissunihockey"
      ? "ch"
      : "se"
---

<Layout
  title={`${data.clubName} ${data.seasonLabel}, trupp och matcher`}
  description={`Trupp, statistik och matcher för ${data.clubName} i ${data.competitionName} ${data.seasonLabel}.`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <PageHeader
      eyebrow={[
        { href: "/serier", label: "Alla serier" },
        {
          href: `/serie/${data.competitionExternalId}`,
          label: data.competitionName,
        },
      ]}
      title={data.clubName}
      description={`${data.competitionName} · ${data.seasonLabel}${
        data.categoryName ? ` · ${data.categoryName}` : ""
      }`}
    />
    {standing ? (
      <dl class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4">
        <div class="border p-3">
          <dt class="text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
            Placering
          </dt>
          <dd class="mt-1 font-heading text-2xl font-semibold tabular-nums">
            {standing.position}
          </dd>
        </div>
        <div class="border p-3">
          <dt class="text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
            Poäng
          </dt>
          <dd class="mt-1 font-heading text-2xl font-semibold tabular-nums">
            {standing.points}
          </dd>
        </div>
        <div class="border p-3">
          <dt class="text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
            Matcher
          </dt>
          <dd class="mt-1 font-heading text-2xl font-semibold tabular-nums">
            {standing.played}
          </dd>
        </div>
        <div class="border p-3">
          <dt class="text-[0.65rem] font-medium tracking-wider text-muted-foreground uppercase">
            Målskillnad
          </dt>
          <dd class="mt-1 font-heading text-2xl font-semibold tabular-nums">
            {goalDifference > 0 ? "+" : ""}
            {goalDifference}
          </dd>
        </div>
      </dl>
    ) : null}

    {skaters.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Trupp</h2>
        <div class="mt-4 border-y">
          <Table className="text-sm">
            <TableHeader>
              <TableRow className="hover:bg-transparent">
                <TableHead className="tracking-wider uppercase">
                  Spelare
                </TableHead>
                {hasPositions ? (
                  <TableHead className="tracking-wider uppercase">
                    Pos
                  </TableHead>
                ) : null}
                <TableHead className="text-right tracking-wider uppercase">
                  <abbr title="Matcher" class="no-underline">
                    M
                  </abbr>
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  Mål
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  Ass
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  P
                </TableHead>
                <TableHead className="hidden text-right tracking-wider uppercase sm:table-cell">
                  Utv
                </TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {skaters.map((entry) => (
                <TableRow>
                  <TableCell className="py-2.5">
                    <a
                      href={`/spelare/${entry.playerExternalId}`}
                      class="hover:underline"
                    >
                      {entry.playerName}
                    </a>
                  </TableCell>
                  {hasPositions ? (
                    <TableCell className="py-2.5 whitespace-nowrap text-muted-foreground">
                      {entry.position ?? "–"}
                    </TableCell>
                  ) : null}
                  <TableCell className="py-2.5 text-right tabular-nums">
                    {entry.matches ?? "-"}
                  </TableCell>
                  <TableCell className="py-2.5 text-right tabular-nums">
                    {entry.goals ?? "-"}
                  </TableCell>
                  <TableCell className="py-2.5 text-right tabular-nums">
                    {entry.assists ?? "-"}
                  </TableCell>
                  <TableCell className="py-2.5 text-right font-semibold tabular-nums">
                    {entry.points ?? "-"}
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-right tabular-nums sm:table-cell">
                    {entry.penaltyMinutes ?? "-"}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </section>
    ) : null}

    {goalies.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Målvakter</h2>
        <div class="mt-4 border-y">
          <Table className="text-sm">
            <TableHeader>
              <TableRow className="hover:bg-transparent">
                <TableHead className="tracking-wider uppercase">
                  Spelare
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  M
                </TableHead>
                <TableHead className="hidden text-right tracking-wider uppercase sm:table-cell">
                  Skott
                </TableHead>
                <TableHead className="hidden text-right tracking-wider uppercase sm:table-cell">
                  IM
                </TableHead>
                <TableHead className="text-right tracking-wider uppercase">
                  Räddning %
                </TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {goalies.map((entry) => (
                <TableRow>
                  <TableCell className="py-2.5">
                    <a
                      href={`/spelare/${entry.playerExternalId}`}
                      class="hover:underline"
                    >
                      {entry.playerName}
                    </a>
                  </TableCell>
                  <TableCell className="py-2.5 text-right tabular-nums">
                    {entry.goalieMatches ?? "-"}
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-right tabular-nums sm:table-cell">
                    {entry.shotsAgainst ?? "-"}
                  </TableCell>
                  <TableCell className="hidden py-2.5 text-right tabular-nums sm:table-cell">
                    {entry.goalsAgainst ?? "-"}
                  </TableCell>
                  <TableCell className="py-2.5 text-right font-semibold tabular-nums">
                    {entry.savePercentage != null
                      ? entry.savePercentage.toFixed(2)
                      : "-"}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </section>
    ) : null}

    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold">Senaste matcherna</h2>
      {finished.length > 0 ? (
        <ul class="mt-4 divide-y border-y">
          {finished.map((game) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 py-2.5 text-sm">
              <span class="truncate text-right">{game.homeName}</span>
              <span class="whitespace-nowrap">
                <Badge
                  variant="secondary"
                  className="font-semibold tabular-nums"
                >
                  {game.homeScore ?? "-"}-{game.awayScore ?? "-"}
                </Badge>
                <span class="text-xs font-normal text-muted-foreground">
                  {suffix(game.decidedBy)}
                </span>
              </span>
              <span class="truncate">{game.awayName}</span>
              <a
                href={`/live/${liveSource}/${game.externalId}`}
                class="col-span-3 text-center text-xs text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground"
              >
                {formatDate(game.startsAt)}
                {game.round ? ` · ${game.round}` : ""}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">
          Inga spelade matcher ännu.
        </p>
      )}
    </section>

    {upcoming.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Kommande matcher</h2>
        <ul class="mt-4 divide-y border-y">
          {upcoming.map((game) => (
            <li class="grid grid-cols-[1fr_auto_1fr] items-baseline gap-3 py-2.5 text-sm">
              <span class="truncate text-right">{game.homeName}</span>
              <span class="whitespace-nowrap text-xs text-muted-foreground">
                {formatDate(game.startsAt)}
              </span>
              <span class="truncate">{game.awayName}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </div>
</Layout>

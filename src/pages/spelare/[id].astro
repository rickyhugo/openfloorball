---
import Layout from "@/layouts/main.astro"
import { getPlayer } from "@/lib/db/queries"

export const prerender = false

const { id } = Astro.params
if (!id) return Astro.redirect("/")

const data = await getPlayer(id)
if (!data) return Astro.redirect("/")

const {
  person,
  rows,
  skaterRows,
  goalieRows,
  skaterTotals,
  goalieTotals,
  savePercentage,
} = data
const latest = rows[0] ?? null
const initials = person.name
  .split(" ")
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("")
---

<Layout
  title={`${person.name}, statistik och karriär`}
  description={`Statistik och karriär för ${person.name}.`}
>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:py-14">
    <nav class="mb-6 text-xs tracking-wider text-muted-foreground uppercase">
      <a
        href="/"
        class="underline decoration-border underline-offset-4 hover:text-foreground"
      >
        Alla serier
      </a>
      {latest ? (
        <>
          <span class="mx-2">/</span>
          <a
            href={`/serie/${latest.competitionExternalId}`}
            class="underline decoration-border underline-offset-4 hover:text-foreground"
          >
            {latest.competitionName}
          </a>
        </>
      ) : null}
    </nav>

    <header class="flex flex-col gap-5 border-b pb-8 sm:flex-row sm:items-center">
      {person.imageUrl ? (
        <img
          src={person.imageUrl}
          alt=""
          width="96"
          height="96"
          loading="lazy"
          referrerpolicy="no-referrer"
          class="size-24 shrink-0 rounded-full border object-cover"
        />
      ) : (
        <div class="flex size-24 shrink-0 items-center justify-center rounded-full border bg-muted font-heading text-2xl text-muted-foreground">
          {initials}
        </div>
      )}
      <div>
        <p class="text-xs font-medium tracking-[0.18em] text-muted-foreground uppercase">
          Spelare
        </p>
        <h1 class="mt-1 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
          {person.name}
        </h1>
        {latest ? (
          <p class="mt-2 text-muted-foreground">
            <a
              href={`/lag/${latest.competitionExternalId}/${latest.teamExternalId}`}
              class="underline decoration-border underline-offset-4 hover:text-foreground"
            >
              {latest.clubName}
            </a>
            {" · "}
            <a
              href={`/serie/${latest.competitionExternalId}`}
              class="underline decoration-border underline-offset-4 hover:text-foreground"
            >
              {latest.competitionName}
            </a>
          </p>
        ) : null}
      </div>
    </header>

    {skaterTotals.matches > 0 ? (
      <section class="mt-8">
        <h2 class="font-heading text-xl font-semibold">Karriär</h2>
        <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-5">
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Matcher
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {skaterTotals.matches}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Mål
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {skaterTotals.goals}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Assists
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {skaterTotals.assists}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Poäng
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {skaterTotals.points}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Utvisning
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {skaterTotals.penaltyMinutes}
            </dd>
          </div>
        </dl>
      </section>
    ) : null}

    {goalieTotals.matches > 0 ? (
      <section class="mt-8">
        <h2 class="font-heading text-xl font-semibold">Målvakt</h2>
        <dl class="mt-3 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Matcher
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {goalieTotals.matches}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Skott
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {goalieTotals.shotsAgainst}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Insläppta
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {goalieTotals.goalsAgainst}
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-wider text-muted-foreground uppercase">
              Räddning %
            </dt>
            <dd class="font-heading text-2xl font-semibold tabular-nums">
              {savePercentage != null ? savePercentage.toFixed(2) : "-"}
            </dd>
          </div>
        </dl>
      </section>
    ) : null}

    {skaterRows.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Säsonger</h2>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left text-xs tracking-wider text-muted-foreground uppercase">
                <th class="py-2 pr-3 font-medium">Säsong</th>
                <th class="py-2 pr-3 font-medium">Serie</th>
                <th class="hidden py-2 pr-3 font-medium sm:table-cell">Lag</th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  M
                </th>
                <th class="py-2 pl-3 text-right font-medium">Mål</th>
                <th class="py-2 pl-3 text-right font-medium">Ass</th>
                <th class="py-2 pl-3 text-right font-medium">P</th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  Utv
                </th>
              </tr>
            </thead>
            <tbody>
              {skaterRows.map((row) => (
                <tr class="border-b border-border/60">
                  <td class="py-2 pr-3 tabular-nums">{row.seasonLabel}</td>
                  <td class="py-2 pr-3">
                    <a
                      href={`/serie/${row.competitionExternalId}`}
                      class="underline decoration-border underline-offset-4 hover:text-foreground"
                    >
                      {row.competitionName}
                    </a>
                  </td>
                  <td class="hidden py-2 pr-3 text-muted-foreground sm:table-cell">
                    <a
                      href={`/lag/${row.competitionExternalId}/${row.teamExternalId}`}
                      class="underline decoration-border underline-offset-4 hover:text-foreground"
                    >
                      {row.clubName}
                    </a>
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {row.matches}
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">{row.goals}</td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {row.assists}
                  </td>
                  <td class="py-2 pl-3 text-right font-semibold tabular-nums">
                    {row.points}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {row.penaltyMinutes}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : null}

    {goalieRows.length > 0 ? (
      <section class="mt-12">
        <h2 class="font-heading text-2xl font-semibold">Målvaktssäsonger</h2>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b text-left text-xs tracking-wider text-muted-foreground uppercase">
                <th class="py-2 pr-3 font-medium">Säsong</th>
                <th class="py-2 pr-3 font-medium">Serie</th>
                <th class="hidden py-2 pr-3 font-medium sm:table-cell">Lag</th>
                <th class="py-2 pl-3 text-right font-medium">M</th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  Skott
                </th>
                <th class="hidden py-2 pl-3 text-right font-medium sm:table-cell">
                  IM
                </th>
                <th class="py-2 pl-3 text-right font-medium">Räddning %</th>
              </tr>
            </thead>
            <tbody>
              {goalieRows.map((row) => (
                <tr class="border-b border-border/60">
                  <td class="py-2 pr-3 tabular-nums">{row.seasonLabel}</td>
                  <td class="py-2 pr-3">
                    <a
                      href={`/serie/${row.competitionExternalId}`}
                      class="underline decoration-border underline-offset-4 hover:text-foreground"
                    >
                      {row.competitionName}
                    </a>
                  </td>
                  <td class="hidden py-2 pr-3 text-muted-foreground sm:table-cell">
                    <a
                      href={`/lag/${row.competitionExternalId}/${row.teamExternalId}`}
                      class="underline decoration-border underline-offset-4 hover:text-foreground"
                    >
                      {row.clubName}
                    </a>
                  </td>
                  <td class="py-2 pl-3 text-right tabular-nums">
                    {row.goalieMatches}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {row.shotsAgainst}
                  </td>
                  <td class="hidden py-2 pl-3 text-right tabular-nums sm:table-cell">
                    {row.goalsAgainst}
                  </td>
                  <td class="py-2 pl-3 text-right font-semibold tabular-nums">
                    {row.savePercentage != null
                      ? row.savePercentage.toFixed(2)
                      : "-"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : null}

    {rows.length === 0 ? (
      <p class="mt-12 text-sm text-muted-foreground">
        Ingen statistik registrerad ännu.
      </p>
    ) : (
      <p class="mt-10 text-xs text-muted-foreground">
        Karriären omfattar de säsonger som är inlästa.
      </p>
    )}
  </div>
</Layout>
